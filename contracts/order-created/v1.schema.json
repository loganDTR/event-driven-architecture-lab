{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OrderCreated",
  "description": "Evento emesso quando un nuovo ordine viene acquisito.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "eventVersion",
    "occurredAt",
    "producer",
    "correlationId",
    "causationId",
    "aggregateId",
    "payload"
  ],
  "properties": {
    "eventId": {
      "$ref": "../common/definitions.schema.json#/$defs/eventId"
    },
    "eventType": {
      "const": "order.created"
    },
    "eventVersion": {
      "const": 1
    },
    "occurredAt": {
      "$ref": "../common/definitions.schema.json#/$defs/timestamp"
    },
    "producer": {
      "$ref": "../common/definitions.schema.json#/$defs/serviceName"
    },
    "correlationId": {
      "$ref": "../common/definitions.schema.json#/$defs/correlationId"
    },
    "causationId": {
      "$ref": "../common/definitions.schema.json#/$defs/causationId"
    },
    "aggregateId": {
      "$ref": "../common/definitions.schema.json#/$defs/aggregateId"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orderId",
        "customerId",
        "currency",
        "totalAmount",
        "items"
      ],
      "properties": {
        "orderId": {
          "type": "string",
          "minLength": 1
        },
        "customerId": {
          "type": "string",
          "minLength": 1
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "totalAmount": {
          "type": "number",
          "minimum": 0
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "productId",
              "quantity",
              "unitPrice"
            ],
            "properties": {
              "productId": {
                "type": "string",
                "minLength": 1
              },
              "quantity": {
                "type": "integer",
                "minimum": 1
              },
              "unitPrice": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    }
  }
}