{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OrderCreated Breaking",
  "description": "Versione self-contained volutamente incompatibile dell'evento OrderCreated. Modifica customerId da stringa a intero.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "eventVersion",
    "occurredAt",
    "producer",
    "correlationId",
    "causationId",
    "aggregateId",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "const": "order.created"
    },
    "eventVersion": {
      "type": "integer",
      "minimum": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "correlationId": {
      "type": "string",
      "format": "uuid"
    },
    "causationId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "aggregateId": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orderId",
        "customerId",
        "currency",
        "totalAmount",
        "items"
      ],
      "properties": {
        "orderId": {
          "type": "string",
          "minLength": 1
        },
        "customerId": {
          "type": "integer",
          "minimum": 1
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "totalAmount": {
          "type": "number",
          "minimum": 0
        },
        "salesChannel": {
          "type": "string",
          "enum": [
            "WEB",
            "MOBILE",
            "STORE"
          ]
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "productId",
              "quantity",
              "unitPrice"
            ],
            "properties": {
              "productId": {
                "type": "string",
                "minLength": 1
              },
              "quantity": {
                "type": "integer",
                "minimum": 1
              },
              "unitPrice": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    }
  }
}